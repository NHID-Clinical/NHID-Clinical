# NHID-Clinical Configuration
# Copy this file to .env and customize for your environment
# SECURITY: Never commit .env with sensitive values to version control

# ============================================================================
# DEPLOYMENT MODE
# ============================================================================
# development  - Allows DEBUG logging, generated keys, hot reload
# staging      - Pre-production testing, full validation
# production   - Locked-down, requires all secrets, no debug output
DEPLOYMENT_MODE=development

# ============================================================================
# AUDIT STORAGE BACKEND
# ============================================================================
# sqlite   - Local file storage (development/testing)
# dynamodb - AWS DynamoDB (production, requires AWS credentials)
AUDIT_STORE_TYPE=sqlite
AUDIT_STORE_PATH=/data/audit_events.db

# DynamoDB configuration (only used if AUDIT_STORE_TYPE=dynamodb)
# AUDIT_DYNAMODB_TABLE=audit-events
# AUDIT_DYNAMODB_REGION=us-east-1

# Audit event retention (days before automatic deletion)
AUDIT_RETENTION_DAYS=90

# External audit anchor (src/audit_anchor.py). REQUIRED in staging/production
# for the /v1/audit/* routes, optional together in development.
# After every audit write a signed, hash-chained checkpoint is appended here, so
# deleting events AND lowering the counter inside the database no longer
# verifies clean. Put this file on different storage from AUDIT_STORE_PATH,
# ideally append-only (chattr +a, S3 Object Lock, a WORM volume).
# AUDIT_ANCHOR_PATH=/anchor/audit.anchor
# Its own base64 32-byte key; must differ from AUDIT_SECRET_KEY_B64 and should
# not be readable by whatever can write the database.
# AUDIT_ANCHOR_KEY_B64=

# Audit key rotation: set the new key as current and move the old one here
# (comma-separated base64). Retired keys only verify older records; they never
# sign. Keep them until every record they signed has passed its retention.
# AUDIT_SECRET_KEYS_RETIRED_B64=
# AUDIT_ANCHOR_KEYS_RETIRED_B64=
#
# Staging and production refuse to start with a required setting missing.
# Check before deploying:  DEPLOYMENT_MODE=production python -m src.preflight

# ============================================================================
# CRYPTOGRAPHIC SECURITY
# ============================================================================
# HMAC secret key for event signing (base64-encoded 32 bytes)
#
# REQUIRED in production. Auto-generated in development if not set.
#
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#
# For production, generate once and store in AWS Secrets Manager:
# aws secretsmanager create-secret \
#   --name nhid/audit-secret-key \
#   --secret-string "$(python -c 'import base64, os; print(base64.b64encode(os.urandom(32)).decode())')"
#
AUDIT_SECRET_KEY_B64=dGhpcyBpcyBhIDMyLWJ5dGUgc2VjcmV0IGtleSBmb3IgdGVzdGluZw==

# ============================================================================
# LOGGING
# ============================================================================
# DEBUG   - Verbose diagnostic output (development only)
# INFO    - Informational messages (default)
# WARNING - Warning messages only
# ERROR   - Error messages only
LOG_LEVEL=INFO

# ============================================================================
# AWS INTEGRATION
# ============================================================================
# AWS region for DynamoDB, CloudWatch, Secrets Manager
AWS_REGION=us-east-1

# LocalStack endpoint URL (local AWS emulation for development)
# Set to http://localstack:4566 when using docker-compose
# Leave unset for production (uses real AWS)
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ============================================================================
# API SERVER
# ============================================================================
# Host and port for FastAPI/uvicorn
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# API AUTHENTICATION
# ============================================================================
# One key per customer (tenant), stored ONLY as a SHA-256 hash. Each request is
# tagged with its tenant, and tenant-scoped data (audit export) is filtered by it.
#
# Hash a key:  python -c "from nhid_api_auth import hash_api_key; print(hash_api_key('the-key'))"
# NHID_API_KEYS={"payer-a": "sha256:<64 hex>", "payer-b": "sha256:<64 hex>"}
#
# Rotation: a tenant may list up to 4 hashes. Add the new one, move clients,
# then remove the old one:
# NHID_API_KEYS={"payer-a": ["sha256:<new>", "sha256:<old>"], "payer-b": "sha256:<64 hex>"}
#
# Legacy single key: authenticates as the tenant "default". Unset both and every
# protected route refuses with 503. A malformed NHID_API_KEYS also refuses (503).
# NHID_API_KEY=

# ============================================================================
# VOICE WEBHOOKS (Twilio)
# ============================================================================
# Auth token used to verify X-Twilio-Signature on /voice/incoming and
# /voice/process. REQUIRED in staging and production: without it every webhook
# is refused (503). In development, unset means unsigned webhooks are accepted
# with a warning.
# TWILIO_AUTH_TOKEN=
#
# The public URL Twilio was configured with, when a proxy rewrites the host or
# scheme (the signature covers the full URL).
# NHID_PUBLIC_BASE_URL=https://api.example.org
#
# /debug/replay returns full call traces. Off (404) in staging and production
# unless set to 1, and then it still requires an API key.
# NHID_ENABLE_DEBUG_REPLAY=0
